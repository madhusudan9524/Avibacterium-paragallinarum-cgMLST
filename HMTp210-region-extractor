import csv, re, sys

PID, COV = 80.0, 0.80
genome_fa, r1tsv, hvtsv, r1q, hvq, idsfile = sys.argv[1:7]

def read_fasta(p):
    d, n, b = {}, None, []
    for line in open(p):
        line = line.strip()
        if line.startswith('>'):
            if n: d[n] = ''.join(b)
            n, b = line[1:].split()[0], []
        else:
            b.append(line)
    if n: d[n] = ''.join(b)
    return d

def strains(p):
    m = {}
    for line in open(p):
        if line.startswith('>'):
            acc = line[1:].split()[0]
            s = re.search(r'strain (\S+)', line)
            m[acc] = s.group(1) if s else acc
    return m

def revcomp(s):
    return s[::-1].translate(str.maketrans('ACGTNacgtn', 'TGCANtgcan'))

def parse(tsv, smap):
    ok, partial = {}, {}
    for row in csv.reader(open(tsv), delimiter='\t'):
        q, s = row[0], row[1]
        pid, qlen = float(row[2]), int(row[4])
        qs, qe, ss, se = map(int, row[5:9])
        bit = float(row[10])
        g = s.split('|', 1)[0]
        cov = (qe - qs + 1) / qlen
        rec = dict(ref=smap.get(q, q), s=s, pid=pid, cov=cov, bit=bit, ss=ss, se=se)
        if g not in partial or bit > partial[g]['bit']:
            partial[g] = rec
        if pid >= PID and cov >= COV:           # rule: highest identity, then coverage
            if g not in ok or (pid, cov) > (ok[g]['pid'], ok[g]['cov']):
                ok[g] = rec
    return ok, partial

genomes = read_fasta(genome_fa)
ids = sorted(set(open(idsfile).read().split()))
res = {}
for label, tsv, qf in (('region1', r1tsv, r1q), ('hvr', hvtsv, hvq)):
    ok, partial = parse(tsv, strains(qf))
    out = {}
    for g in ids:
        if g in ok:
            h = ok[g]
            lo, hi = min(h['ss'], h['se']), max(h['ss'], h['se'])
            seq = genomes[h['s']][lo-1:hi]
            strand = '+'
            if h['ss'] > h['se']:
                seq, strand = revcomp(seq), '-'
            out[g] = dict(status='RECOVERED', ref=h['ref'], pid=h['pid'], cov=h['cov'],
                          contig=h['s'].split('|', 1)[1], start=lo, end=hi,
                          strand=strand, seq=seq)
        elif g in partial:
            h = partial[g]
            out[g] = dict(status='NOT_RECOVERED', ref=h['ref'], pid=h['pid'], cov=h['cov'],
                          contig='', start='', end='', strand='', seq='')
        else:
            out[g] = dict(status='NO_HIT', ref='', pid='', cov='', contig='', start='', end='', strand='', seq='')
    res[label] = out
    with open(f'{label}.fasta', 'w') as fa:
        for g in ids:
            if out[g]['seq']:
                fa.write(f">{g}_{label}\n{out[g]['seq']}\n")

n_both = 0
with open('summary.tsv', 'w') as sm, open('concatenated.fasta', 'w') as cat:
    cols = ['status','ref','pident','coverage','contig','start','end','strand','length']
    sm.write('genome\t' + '\t'.join(f'r1_{c}' for c in cols) + '\t' + '\t'.join(f'hvr_{c}' for c in cols) + '\tboth\tsame_contig\n')
    for g in ids:
        a, b = res['region1'][g], res['hvr'][g]
        both = a['status'] == 'RECOVERED' and b['status'] == 'RECOVERED'
        same = ('YES' if a['contig'] == b['contig'] else 'NO') if both else ''
        def fmt(x):
            p = f"{x['pid']:.1f}" if x['pid'] != '' else ''
            c = f"{x['cov']:.2f}" if x['cov'] != '' else ''
            return [x['status'], x['ref'], p, c, x['contig'], str(x['start']), str(x['end']), x['strand'], str(len(x['seq'])) if x['seq'] else '']
        sm.write(g + '\t' + '\t'.join(fmt(a)) + '\t' + '\t'.join(fmt(b)) + f"\t{'YES' if both else 'NO'}\t{same}\n")
        if both:
            cat.write(f">{g}\n{a['seq']}{b['seq']}\n"); n_both += 1

n = len(ids)
for label in ('region1', 'hvr'):
    c = sum(1 for g in ids if res[label][g]['status'] == 'RECOVERED')
    print(f'{label}: recovered {c} of {n}')
print(f'both (concatenated): {n_both} of {n}')
